# Backend production settings
PORT=8080
DB_URL=jdbc:mysql://localhost:3306/student_tracker
DB_USERNAME=tracker_app
DB_PASSWORD=replace-with-a-secret
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=86400000
FACULTY_ACCESS_CODE=replace-with-a-private-code
FRONTEND_ORIGIN=https://your-frontend.vercel.app
STORAGE_LOCAL_DIRECTORY=./data/evidence
NOTIFICATIONS_CRON=0 0 9 * * *
NOTIFICATIONS_TIMEZONE=Asia/Kolkata

# Optional development-only seed accounts. Leave unset in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
